{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"title": "Ren Studio",
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "800px",
			"wideSize": "1280px"
		},
		"useRootPaddingAwareAlignments": true,
		"background": {
			"backgroundImage": true,
			"backgroundSize": true
		},
		"color": {
			"defaultPalette": false,
			"defaultDuotone": false,
			"custom": true,
			"customDuotone": true,
			"customGradient": true,
			"palette": [
				{ "slug": "background", "name": "White", "color": "#ffffff" },
				{ "slug": "surface", "name": "Light Grey", "color": "#f5f5f5" },
				{ "slug": "foreground", "name": "Ink Black", "color": "#0a0a0a" },
				{ "slug": "muted", "name": "Muted Grey", "color": "#6b6b6b" },
				{ "slug": "accent", "name": "Electric Violet", "color": "#b026ff" },
				{ "slug": "accent-alt", "name": "Acid Green", "color": "#baff29" },
				{ "slug": "accent-coral", "name": "Hot Coral", "color": "#ff5470" },
				{ "slug": "border", "name": "Hairline", "color": "#e2e2e2" }
			],
			"gradients": [
				{
					"slug": "violet-fade",
					"name": "Violet Fade",
					"gradient": "linear-gradient(160deg, #b026ff 0%, rgba(176,38,255,0) 60%)"
				},
				{
					"slug": "ink-fade",
					"name": "Ink Fade",
					"gradient": "linear-gradient(180deg, rgba(0,0,0,0) 0%, var(--wp--preset--color--background) 90%)"
				}
			]
		},
		"typography": {
			"customFontSize": true,
			"fluid": true,
			"lineHeight": true,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display (Headings)",
					"fontFamily": "\"Space Grotesk\", -apple-system, BlinkMacSystemFont, sans-serif"
				},
				{
					"slug": "body",
					"name": "Body (Text)",
					"fontFamily": "\"Inter\", -apple-system, BlinkMacSystemFont, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Mono (Specs/Labels)",
					"fontFamily": "\"JetBrains Mono\", ui-monospace, Menlo, monospace"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.125rem", "fluid": { "min": "1rem", "max": "1.25rem" } },
				{ "slug": "large", "name": "Large", "size": "1.5rem", "fluid": { "min": "1.25rem", "max": "1.75rem" } },
				{ "slug": "x-large", "name": "XL", "size": "2.5rem", "fluid": { "min": "1.875rem", "max": "3rem" } },
				{ "slug": "xx-large", "name": "XXL", "size": "4rem", "fluid": { "min": "2.5rem", "max": "5.5rem" } },
				{ "slug": "hero", "name": "Hero", "size": "6rem", "fluid": { "min": "3rem", "max": "8rem" } }
			]
		},
		"spacing": {
			"customMargin": true,
			"customPadding": true,
			"units": [ "px", "em", "rem", "%", "vh", "vw" ],
			"spacingScale": {
				"operator": "*",
				"increment": 1.5,
				"steps": 7,
				"mediumStep": 1.5,
				"unit": "rem"
			},
			"blockGap": true
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"custom": {
			"spacing": {
				"section-gap": "clamp(4rem, 8vw, 9rem)"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--custom--color--body)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--custom--color--heading)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600",
					"lineHeight": "1.1",
					"letterSpacing": "-0.02em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"link": {
				"color": { "text": "var(--wp--custom--color--link)" },
				":hover": { "color": { "text": "var(--wp--custom--color--link-hover)" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--background)"
				},
				"typography": { "fontWeight": "600" },
				"border": { "radius": "999px" },
				"spacing": { "padding": { "top": "0.9rem", "bottom": "0.9rem", "left": "1.75rem", "right": "1.75rem" } },
				":hover": {
					"color": {
						"background": "var(--wp--custom--color--accent-hover)",
						"text": "var(--wp--preset--color--background)"
					}
				}
			}
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": { "top": "0px", "bottom": "0px", "left": "1.5rem", "right": "1.5rem" }
		},
		"blocks": {
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--border)" }
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "1.25rem",
					"fontWeight": "700"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"spacing": { "blockGap": "2rem" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "sidebar-blog", "title": "Blog Sidebar", "area": "uncategorized" }
	],
	"customTemplates": [
		{ "name": "page-portfolio", "title": "Portfolio Landing", "postTypes": [ "page" ] }
	]
}
